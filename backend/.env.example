# Application Configuration
APP_ENV=development
APP_NAME=dogfood-api

# Database Configuration
# psycopg 3 supports both the async application engine and sync Alembic engine.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dogfood

# Logging Configuration
LOG_LEVEL=INFO

# JWT Authentication Configuration
# IMPORTANT: Generate a secure random secret key for production
# Example: openssl rand -hex 32
JWT_SECRET_KEY=
# Required: paste output of openssl rand -hex 32 above before starting.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

JWT_ISSUER=dogfood-api
JWT_AUDIENCE=dogfood-api
# /auth/logout revokes the current session; /auth/logout-all invalidates the account.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
