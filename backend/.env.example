# Application Configuration
APP_ENV=development
APP_NAME=dogfood-api

# Database Configuration
# psycopg 3 supports both the async application engine and sync Alembic engine.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dogfood

# Logging Configuration
LOG_LEVEL=INFO

# JWT Authentication Configuration
# IMPORTANT: Generate a secure random secret key for production
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
