# Application Configuration
APP_ENV=development
APP_NAME=dogfood-api
API_V1_PREFIX=/api/v1

# Database Configuration
# psycopg 3 supports both the async application engine and sync Alembic engine.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dogfood

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
